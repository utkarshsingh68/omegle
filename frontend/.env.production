# Production Environment Variables
# Update these values after AWS deployment

# Backend URL - Update with your EC2 Elastic IP or domain
VITE_SOCKET_URL=https://api.your-domain.com

# Or use EC2 IP directly:
# VITE_SOCKET_URL=http://YOUR_ELASTIC_IP:3001

# TURN Server (required for reliable video calls)
# Option 1: Self-hosted TURN (coturn on EC2/Fly.io/VPS)
# VITE_TURN_URL=turn:YOUR_TURN_SERVER_IP:3478
# VITE_TURN_USER=your_username
# VITE_TURN_PASS=your_password

# Option 2: Metered.ca API (recommended - no server needed)
# Sign up at https://www.metered.ca/stun-turn
# VITE_METERED_API_KEY=your_api_key_here
