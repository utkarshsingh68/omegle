# Frontend Environment Variables
VITE_SOCKET_URL=http://localhost:3001

# ============================================
# TURN Server Configuration (Required for reliable video)
# ============================================

# OPTION 1: Self-hosted TURN (EC2/Fly.io/VPS)
# After deploying coturn, fill in these values:
# VITE_TURN_URL=turn:YOUR_SERVER_IP:3478
# VITE_TURN_USER=your_username
# VITE_TURN_PASS=your_password

# OPTION 2: Metered.ca Paid TURN (Recommended - no server needed)
# Sign up at https://www.metered.ca/stun-turn
# Free tier: 500GB/month, Paid: starts at $0.04/GB
# VITE_METERED_API_KEY=your_api_key_here
